    <string name="add_word_title">Добавить слово</string>
    <style name="ActionButtonEdit">
        <item name="android:layout_width">@dimen/icon_size_medium</item>
        <item name="android:layout_height">@dimen/icon_size_medium</item>
        <item name="android:src">@drawable/pencilicon</item>
        <item name="android:background">@drawable/btn_gray_rounded</item>
        <item name="android:tint">@color/greenMain</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:layout_marginStart">@dimen/action_button_margin_start</item>
    </style>
    <style name="ActionButtonSpeaker">
        <item name="android:layout_width">@dimen/icon_size_medium</item>
        <item name="android:layout_height">@dimen/icon_size_medium</item>
        <item name="android:src">@drawable/volumeicon</item>
        <item name="android:background">@drawable/btn_green_rounded</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:layout_marginStart">@dimen/action_button_margin_start</item>
        <item name="android:layout_marginTop">@dimen/action_button_margin_top</item>
    </style>
    <style name="ButtonAdd">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_size_large</item>
        <item name="android:backgroundTint">@color/greenMain</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:paddingHorizontal">@dimen/button_padding_horizontal</item>
    </style>
    <style name="CardAddWord">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginHorizontal">@dimen/card_margin_horizontal_small</item>
        <item name="android:layout_marginTop">@dimen/card_margin_top_medium</item>
        <item name="android:layout_marginBottom">@dimen/card_margin_bottom_medium</item>
        <item name="android:padding">@dimen/card_padding_medium</item>
        <item name="android:background">@drawable/card_white_rounded</item>
        <item name="android:elevation">@dimen/card_elevation</item>
    </style>
    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/divider_height</item>
        <item name="android:background">@color/divider</item>
    </style>
    <style name="HeaderLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/header_height</item>
        <item name="android:layout_marginTop">@dimen/header_margin_top</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/header_padding_horizontal</item>
    </style>
    <style name="HeaderTitle">
        <item name="android:textSize">@dimen/text_size_header</item>
        <item name="android:textColor">@color/darkGreen</item>
    </style>
    <style name="IconLarge">
        <item name="android:layout_width">@dimen/icon_size_large</item>
        <item name="android:layout_height">@dimen/icon_size_large</item>
    </style>
    <style name="ImageAddWord">
        <item name="android:layout_width">@dimen/image_size_medium</item>
        <item name="android:layout_height">@dimen/image_size_medium</item>
    </style>
    <style name="ScrollContent">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">@dimen/scroll_padding_top</item>
        <item name="android:paddingBottom">@dimen/scroll_padding_bottom</item>
    </style>
    <style name="TextSecondaryDark">
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textColor">@color/textSecondaryDark</item>
    </style>
    <style name="TextTitle">
        <item name="android:textSize">@dimen/text_size_xl</item>
        <item name="android:textColor">@color/textMainColor</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>