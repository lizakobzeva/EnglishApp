<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/word"
    android:layout_width="match_parent"
    android:layout_height="104dp"
    android:layout_marginHorizontal="20dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="14dp"
    android:padding="11dp"
    android:orientation="horizontal"
    android:background="@drawable/card_white_rounded"
    android:elevation="6dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/image_word"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@mipmap/enlish_flag_img"
        android:scaleType="centerCrop"
        android:layout_marginEnd="20dp"
        android:background="@drawable/rounded_image_background"
        android:clipToOutline="true" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

            <TextView
                android:id="@+id/word_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kot"
                android:textColor="@color/textMainColor"
                android:textSize="24sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/word_translation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manufacturer"
                android:textColor="@color/greenMain"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/word_pronunciation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[kaet]"
                android:textColor="@color/textMainColor"
                android:textSize="10sp"
                />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >

        <ImageView
            android:id="@+id/edit_icon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/pencilicon"
            android:background="@drawable/btn_gray_rounded"
            android:tint="@color/greenMain"
            android:scaleType="centerInside"
            android:layout_marginStart="16dp" />
    <ImageView
        android:layout_marginTop="13dp"
        android:id="@+id/speaker_icon"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/volumeicon"
        android:background="@drawable/btn_green_rounded"
        android:scaleType="centerInside"
        android:layout_marginStart="16dp" />

    </LinearLayout>

</LinearLayout>