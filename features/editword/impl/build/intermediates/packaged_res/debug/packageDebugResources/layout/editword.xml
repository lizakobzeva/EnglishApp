<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                style="@style/HeaderLayout">
                <ImageView
                    android:id="@+id/close"
                    style="@style/IconLarge"
                    android:src="@drawable/round_arrow_back"
                    android:layout_marginEnd="@dimen/back_button_margin_end"
                    />

                <TextView
                    android:id="@+id/title_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Редактирование"
                    style="@style/HeaderTitle"
                    />

                <ImageView
                    android:id="@+id/delete_word"
                    android:layout_width="@dimen/icon_size_large"
                    android:layout_height="@dimen/icon_size_large"
                    android:src="@drawable/ic_delete"
                    android:contentDescription="Удалить слово"
                    android:padding="@dimen/icon_action_padding"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    />

            </LinearLayout>
            <View style="@style/Divider" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="@dimen/bottom_bar_padding_horizontal_medium"
            >
            <ImageView
                android:layout_marginTop="@dimen/image_margin_top"
                android:id="@+id/edit_word_image"
                style="@style/ImageEditWord"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/edit_image_view"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/form_field_margin_top_large"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Слово"
                    style="@style/TextLabel" />

                <EditText
                    android:id="@+id/editWord"
                    style="@style/EditTextDefault"
                    android:text="Cat" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/form_field_margin_top"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Перевод"
                    style="@style/TextLabel" />

                <EditText
                    android:id="@+id/editTranslation"
                    style="@style/EditTextDefault"
                    android:text="Кошка" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/form_field_margin_top"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Произношение"
                    style="@style/TextLabel" />

                <EditText
                    android:id="@+id/editPronunciation"
                    style="@style/EditTextDefault"
                    android:text="[kæt]"
                    android:layout_marginBottom="@dimen/edittext_margin_bottom_xl" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        style="@style/BottomBarCenter">

        <Button
            android:id="@+id/btn_learning"
            style="@style/ButtonPrimaryMedium"
            android:text="Сохранить" />
    </LinearLayout>
</FrameLayout>


