<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/word"
    style="@style/CardWord">

    <ImageView
        android:id="@+id/image_word"
        style="@style/ImageWord"
        android:src="@mipmap/enlish_flag_img" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

            <TextView
                android:id="@+id/word_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kot"
                style="@style/TextTitle" />
            <TextView
                android:id="@+id/word_translation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Manufacturer"
                style="@style/TextTranslation" />

            <TextView
                android:id="@+id/word_pronunciation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[kaet]"
                style="@style/TextPronunciation" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >

        <ImageView
            android:id="@+id/edit_icon"
            style="@style/ActionButtonEdit" />
    <ImageView
        android:id="@+id/speaker_icon"
        style="@style/ActionButtonSpeaker" />

    </LinearLayout>

</LinearLayout>