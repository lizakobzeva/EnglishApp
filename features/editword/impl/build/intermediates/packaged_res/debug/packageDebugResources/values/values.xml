<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="darkGreen">#485F43</color>
    <color name="divider">#E0E0E0</color>
    <color name="grayMain">#F1F1F1</color>
    <color name="greenMain">#57934B</color>
    <color name="textMainColor">#1A1A1A</color>
    <color name="white">#FFFFFFFF</color>
    <dimen name="back_button_margin_end">36dp</dimen>
    <dimen name="bottom_bar_padding_horizontal_medium">30dp</dimen>
    <dimen name="button_height">55dp</dimen>
    <dimen name="button_width_medium">280dp</dimen>
    <dimen name="divider_height">1dp</dimen>
    <dimen name="edittext_margin_bottom">8dp</dimen>
    <dimen name="edittext_margin_bottom_xl">32dp</dimen>
    <dimen name="edittext_padding">12dp</dimen>
    <dimen name="form_field_margin_top">20dp</dimen>
    <dimen name="form_field_margin_top_large">30dp</dimen>
    <dimen name="header_height">56dp</dimen>
    <dimen name="header_margin_top">8dp</dimen>
    <dimen name="header_padding_horizontal">20dp</dimen>
    <dimen name="icon_action_padding">8dp</dimen>
    <dimen name="icon_size_large">40dp</dimen>
    <dimen name="image_margin_top">23dp</dimen>
    <dimen name="image_size_large">310dp</dimen>
    <dimen name="spacing_large">16dp</dimen>
    <dimen name="spacing_medium">12dp</dimen>
    <dimen name="spacing_small">8dp</dimen>
    <dimen name="spacing_xl">20dp</dimen>
    <dimen name="text_size_header">18sp</dimen>
    <dimen name="text_size_large">18sp</dimen>
    <dimen name="text_size_medium">16sp</dimen>
    <dimen name="text_size_xxl">26sp</dimen>
    <style name="BottomBarCenter">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">73dp</item>
        <item name="android:layout_gravity">bottom</item>
        <item name="android:background">@color/white</item>
        <item name="android:elevation">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">@dimen/bottom_bar_padding_horizontal_medium</item>
    </style>
    <style name="ButtonPrimaryMedium">
        <item name="android:layout_width">@dimen/button_width_medium</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:textSize">@dimen/text_size_xxl</item>
        <item name="android:backgroundTint">@color/greenMain</item>
    </style>
    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/divider_height</item>
        <item name="android:background">@color/divider</item>
    </style>
    <style name="EditTextDefault">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">@dimen/edittext_padding</item>
        <item name="android:textSize">@dimen/text_size_medium</item>
        <item name="android:textColor">@color/textMainColor</item>
        <item name="android:textColorHint">#999999</item>
        <item name="android:background">@drawable/btn_gray_rounded</item>
    </style>
    <style name="HeaderLayout">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/header_height</item>
        <item name="android:layout_marginTop">@dimen/header_margin_top</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingHorizontal">@dimen/header_padding_horizontal</item>
    </style>
    <style name="HeaderTitle">
        <item name="android:textSize">@dimen/text_size_header</item>
        <item name="android:textColor">@color/darkGreen</item>
    </style>
    <style name="IconLarge">
        <item name="android:layout_width">@dimen/icon_size_large</item>
        <item name="android:layout_height">@dimen/icon_size_large</item>
    </style>
    <style name="ImageEditWord">
        <item name="android:layout_width">@dimen/image_size_large</item>
        <item name="android:layout_height">@dimen/image_size_large</item>
        <item name="android:background">@drawable/rounded_image_background</item>
    </style>
    <style name="TextLabel">
        <item name="android:textSize">@dimen/text_size_large</item>
        <item name="android:textColor">@color/textMainColor</item>
        <item name="android:layout_marginBottom">@dimen/edittext_margin_bottom</item>
    </style>
</resources>