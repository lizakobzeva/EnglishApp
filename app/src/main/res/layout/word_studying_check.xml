<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/word_studying_check_exit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="26sp"
        android:src="@drawable/exit"
        android:textColor="#000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="32dp"
        android:layout_marginStart="16dp"/>

    <TextView
        android:id="@+id/word_studying_check_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="20/60"
        android:textSize="26sp"
        android:textColor="#000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"/>

    <ProgressBar
        android:id="@+id/word_studying_check_progressbutton"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="360dp"
        android:layout_height="20dp"
        android:max="100"
        android:progress="50"
        android:progressDrawable="@drawable/custom_progress_bar"
        app:layout_constraintBottom_toTopOf="@+id/word_studying_check_titletext"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="75dp"/>

    <TextView
        android:id="@+id/word_studying_check_titletext"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Программирование"
        android:textSize="34sp"
        android:textColor="#000000"
        android:textAlignment="center"
        app:layout_constraintBottom_toTopOf="@+id/word_studying_check_editWord"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="30dp"/>

    <EditText
        android:id="@+id/word_studying_check_editWord"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Programming"
        android:textSize="20sp"
        android:textColor="#000000"
        android:gravity="top|start"
        android:minHeight="120dp"
        android:paddingTop="36dp"
        android:paddingStart="36dp"
        android:paddingBottom="36dp"
        android:background="#F5F5F5"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.4"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="25dp"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/word_studying_check_checkbutton"
            android:layout_width="300dp"
            android:layout_height="70dp"
            android:text="Проверить"
            android:backgroundTint="@color/greenMain"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:paddingHorizontal="20dp"
            android:layout_marginHorizontal="56dp"
            android:layout_gravity="end"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>